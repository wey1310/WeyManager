rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mặc định từ chối mọi truy cập không được cho phép.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /classes/{classId} {
        allow read, write: if isOwner(userId)
          && isValidId(userId)
          && isValidId(classId);

        match /students/{studentId} {
          allow read, write: if isOwner(userId)
            && isValidId(userId)
            && isValidId(classId)
            && isValidId(studentId);
        }

        match /grades/{gradeId} {
          allow read, write: if isOwner(userId)
            && isValidId(userId)
            && isValidId(classId)
            && isValidId(gradeId);
        }

        match /weeks/{weekId} {
          allow read, write: if isOwner(userId)
            && isValidId(userId)
            && isValidId(classId)
            && isValidId(weekId);
        }

        match /points/{pointId} {
          allow read, write: if isOwner(userId)
            && isValidId(userId)
            && isValidId(classId)
            && isValidId(pointId);
        }
      }

      match /timetables/{timetableId} {
        allow read, write: if isOwner(userId)
          && isValidId(userId)
          && isValidId(timetableId);
      }

      // Ghi chú công việc trên lịch.
      match /calendarNotes/{noteId} {
        allow read, write: if isOwner(userId)
          && isValidId(userId)
          && isValidId(noteId);
      }
    }
  }
}